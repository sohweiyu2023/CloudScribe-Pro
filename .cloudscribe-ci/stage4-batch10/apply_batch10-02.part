schema/seed validation.\n- Any inferred production Ed25519 trust anchor.\n- Stage 4 completion or promotion.\n\nReason\n- The active source/file-retrieval context contains the controlling prompt and historical validation evidence but not the authoritative machine-readable pricing schema/seed, runtime-policy schema/seed, or intended production trust-anchor bytes. Their field/taxonomy semantics must not be recreated from summaries.\n''',
}


def replace_once(path: str, old: str, new: str) -> None:
    target = ROOT / path
    text = target.read_text(encoding="utf-8")
    if text.count(old) != 1:
        raise ValueError(f"Expected one transform anchor in {path}: {old[:80]!r}; found {text.count(old)}")
    target.write_text(text.replace(old, new, 1), encoding="utf-8")


def write_new_files() -> None:
    for relative, content in NEW_FILES.items():
        path = ROOT / relative
        if path.exists():
            raise ValueError(f"Batch 10 new file already exists: {relative}")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


