<UserControl
    x:Class="CloudScribe.App.Views.DocumentLibraryPanel"
    x:DataType="vm:ShellViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:documents="using:CloudScribe.Application.Documents"
    xmlns:vm="using:CloudScribe.App.ViewModels"
    IsVisible="{Binding CurrentPage.IsDocumentLibraryRoute}"
    Background="{DynamicResource Brush.SurfaceInset}">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28">
    <Grid MaxWidth="980" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,*" RowSpacing="18">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel MinWidth="0" Spacing="3">
          <TextBlock Text="LOCAL DOCUMENT LIBRARY" Foreground="{DynamicResource Brush.CyanBright}" FontWeight="Bold" FontSize="{DynamicResource Typography.Caption}" />
          <TextBlock Text="Documents stay on this device" Foreground="{DynamicResource Brush.TextOnDark}" FontWeight="SemiBold" FontSize="{DynamicResource Typography.Title}" />
          <TextBlock Text="Open, search, import or create documents without provider credentials." Foreground="{DynamicResource Brush.TextOnDarkMuted}" TextWrapping="Wrap" />
          <Button Content="Export complete article MP3" Command="{Binding RequestArticleExportCommand}" Classes="secondary" AutomationProperties.Name="Export complete article MP3" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="Refresh" Command="{Binding RefreshDocumentLibraryCommand}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="secondary" Content="Import…" Command="{Binding ImportDocumentCommand}" VerticalAlignment="Center" AutomationProperties.Name="Import a local document" />
        <Button Grid.Column="3" Classes="primary" Content="New document" Command="{Binding NewDocumentCommand}" VerticalAlignment="Center" AutomationProperties.Name="Create a new local document" />
      </Grid>

      <TextBox
          Grid.Row="1"
          Text="{Binding LibrarySearchQuery, Mode=TwoWay}"
          PlaceholderText="Search local documents"
          AutomationProperties.Name="Search local document library" />

      <Border Grid.Row="2" Background="{DynamicResource Brush.PanelGradient}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto" Margin="8,4">
            <TextBlock Text="{Binding CurrentPage.StateTitle}" Foreground="{DynamicResource Brush.TextOnDark}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentPage.StateKind}" Foreground="{DynamicResource Brush.CyanBright}" FontSize="{DynamicResource Typography.Caption}" FontWeight="Bold" />
          </Grid>
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4">
            <Button Content="Previous page" Command="{Binding PreviousLibraryPageCommand}" Classes="secondary" AutomationProperties.Name="Previous library page" />
            <Button Content="Next page" Command="{Binding NextLibraryPageCommand}" Classes="secondary" AutomationProperties.Name="Next library page" />
            <TextBlock Text="200 articles per page; all articles stay stored locally." Foreground="{DynamicResource Brush.TextOnDarkMuted}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </WrapPanel>
          <ItemsControl Grid.Row="2" MinHeight="360" ItemsSource="{Binding LibraryArticles}" AutomationProperties.Name="Local articles and narration parts">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryArticleViewModel">
                <Border Margin="3" Padding="14" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Document.Title}" Foreground="{DynamicResource Brush.TextOnDark}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Content="Open article" Command="{Binding OpenCommand}" CommandParameter="{Binding Document.Id}" Classes="secondary" />
                    </Grid>
                    <Expander IsVisible="{Binding HasParts}" Header="{Binding PartsLabel}" IsExpanded="{Binding ExpandParts, Mode=OneWay}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding PreparationStatus}" Foreground="{DynamicResource Brush.TextOnDarkMuted}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Parts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryPartViewModel">
                              <Border Padding="10" Margin="0,3" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                  <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Document.Title}" Foreground="{DynamicResource Brush.TextOnDark}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.TextOnDarkMuted}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <Button Grid.Column="1" Content="Open part" Command="{Binding OpenCommand}" CommandParameter="{Binding Document.Id}" Classes="secondary" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
