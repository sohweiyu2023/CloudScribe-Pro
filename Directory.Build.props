<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Public API XML documentation is introduced module-by-module; suppress only CS1591 during staged prerelease work. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Keep advisory-source integrity failures strict in the dedicated audit restore,
      but let actual vulnerability findings (NU1901-NU1904) reach the machine-readable
      machine-readable dotnet vulnerability report. The JSON validator remains the
      fail-closed authority for findings. Ordinary restore/build/test remains resilient
      to transient audit metadata warnings without disabling NuGet Audit.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <CloudScribeNuGetAuditInfrastructureCodes>NU1900;NU1905</CloudScribeNuGetAuditInfrastructureCodes>
    <CloudScribeNuGetAuditFindingCodes>NU1901;NU1902;NU1903;NU1904</CloudScribeNuGetAuditFindingCodes>
    <WarningsAsErrors Condition="'$(CloudScribeNuGetAuditPipeline)' == 'true'">$(WarningsAsErrors);$(CloudScribeNuGetAuditInfrastructureCodes)</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(CloudScribeNuGetAuditFindingCodes)</WarningsNotAsErrors>
    <WarningsNotAsErrors Condition="'$(CloudScribeNuGetAuditPipeline)' != 'true'">$(WarningsNotAsErrors);$(CloudScribeNuGetAuditInfrastructureCodes)</WarningsNotAsErrors>
    <!-- CloudScribe builds must remain offline-capable and deterministic. Avalonia build telemetry is optional. -->
    <CloudScribeDisableAvaloniaBuildTelemetry>true</CloudScribeDisableAvaloniaBuildTelemetry>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>
</Project>
